# ==================== 部署版本与端口（P6 Docker Compose） ====================
# 固定镜像版本标签（严禁使用 latest，便于按版本回滚）
APP_VERSION=1.0.0
# 对外监听地址（默认仅本机回环；内网发布时按需改为内网网卡 IP 或 0.0.0.0）
APP_BIND_IP=127.0.0.1
APP_PORT=8080
# 宿主机只读 SSH 私钥与 known_hosts 目录（容器内只读挂载至 /run/ssh_keys）
SSH_KEYS_HOST_DIR=./ssh_keys

# 可选：国内构建加速源
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# NPM_REGISTRY=https://registry.npmmirror.com

# ==================== 应用安全配置（生产 Fail-Fast 强校验） ====================
# 运行环境：development（开发）或 production（生产，缺强密钥/弱密码直接拒启）
APP_ENV=production

# 认证签名密钥与可选独立发件箱加密主密钥（均须 >=12 位强随机串，严禁含 changeme 等占位词）
AUTH_SECRET=changeme_replace_with_32char_random_secret
# CREDENTIAL_MASTER_KEY=

# 双角色账号与强口令（生产必须 >=12 位且不含占位词）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_replace_with_strong_admin_pwd
VIEWER_USERNAME=duskk
VIEWER_PASSWORD=changeme_replace_with_strong_viewer_pwd

# 受控 CORS 白名单（英文逗号分隔，严禁使用 *）
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# ==================== 存储、SSH 与留存策略 ====================
DB_PATH=/data/ops_inspect.db
SSH_KEYS_DIR=/run/ssh_keys
# 生产默认强制校验 known_hosts，防止静默降级 AutoAddPolicy（仅可信测试网可显式设为 false）
SSH_STRICT_HOST_KEY=true
MAX_OUTBOX_ROWS=500
MAX_AUDIT_ROWS=2000

# ==================== 可选：环境变量 SMTP 兜底（也可由管理员在 Web 端加密热配多发件箱） ====================
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=changeme_smtp_auth_code
SMTP_FROM=ops-inspect@corp.local
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=10
