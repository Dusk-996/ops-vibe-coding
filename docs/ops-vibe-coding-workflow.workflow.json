{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Ops Vibe Coding 完整流程",
    "locale": "zh-CN",
    "output": "docs/ops-vibe-coding-workflow.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "full-loop",
        "label": "完整反馈闭环",
        "focus": [
          "idea",
          "prototype",
          "prototype_review",
          "react",
          "parity",
          "architecture",
          "build_review",
          "ops_readiness",
          "e2e",
          "acceptance",
          "architecture_refine",
          "feedback"
        ],
        "note": "主路径向前推进，所有门禁都可以把工作送回需要修正的阶段。"
      },
      {
        "id": "prototype-and-parity",
        "label": "原型与产品契约",
        "focus": [
          "idea",
          "prototype",
          "prototype_review",
          "react",
          "parity"
        ],
        "note": "先让真实使用者确认意图，再把批准的原型转成 React + Mock。"
      },
      {
        "id": "architecture-and-spec",
        "label": "架构与规格",
        "focus": [
          "react",
          "parity",
          "architecture",
          "architecture_refine"
        ],
        "note": "UI 暴露能力候选，Grill 确认约束，Spec 固化可测试行为。"
      },
      {
        "id": "build-and-operations",
        "label": "实现与运行证据",
        "focus": [
          "architecture",
          "build_review",
          "feedback",
          "ops_readiness",
          "e2e"
        ],
        "note": "实现、审查、运维就绪和真实浏览器证据共同决定能否继续。"
      },
      {
        "id": "acceptance",
        "label": "验收与交付",
        "focus": [
          "e2e",
          "acceptance",
          "feedback"
        ],
        "note": "测试通过仍需由人确认软件解决了最初的问题。"
      }
    ]
  },
  "lanes": [
    { "id": "intent", "label": "产品意图" },
    { "id": "early_gates", "label": "早期人工门禁" },
    { "id": "parity_gate", "label": "Parity 门禁" },
    { "id": "contract", "label": "架构与契约" },
    { "id": "architecture_feedback", "label": "架构反馈", "variant": "exception" },
    { "id": "delivery", "label": "实现与交付" },
    { "id": "late_feedback", "label": "交付反馈", "variant": "exception" },
    { "id": "late_gates", "label": "运行门禁" },
    { "id": "outcomes", "label": "验收结果" }
  ],
  "phases": [
    { "id": "prototype_phase", "label": "Prototype + Intent", "fromCol": 0, "toCol": 1 },
    { "id": "contract_phase", "label": "Architecture + SDD", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "delivery_phase", "label": "Build + Ops + Acceptance", "fromCol": 4, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": [
    "idea",
    "prototype",
    "prototype_review",
    "react",
    "parity",
    "architecture",
    "build_review",
    "ops_readiness",
    "e2e",
    "acceptance"
  ],
  "semanticChecks": {
    "allowedRoots": ["idea"],
    "allowedTerminals": ["acceptance"],
    "requiredPaths": [
      { "from": "idea", "to": "acceptance" },
      { "from": "parity", "to": "react" },
      { "from": "ops_readiness", "to": "feedback" },
      { "from": "e2e", "to": "feedback" }
    ]
  },
  "nodes": [
    {
      "id": "idea",
      "lane": "intent",
      "col": 0,
      "width": 128,
      "type": "external",
      "label": "Ops Idea",
      "sublabel": "运维问题与目标",
      "tag": "START"
    },
    {
      "id": "prototype",
      "lane": "intent",
      "col": 1,
      "width": 220,
      "type": "frontend",
      "label": "HTML Prototype",
      "sublabel": "自制 / Beautiful Ops Pages / Beautiful Ops Platform"
    },
    {
      "id": "prototype_review",
      "lane": "early_gates",
      "col": 1,
      "width": 140,
      "type": "security",
      "label": "Prototype Review",
      "sublabel": "产品意图获批?",
      "tag": "HUMAN GATE"
    },
    {
      "id": "react",
      "lane": "delivery",
      "col": 2,
      "width": 160,
      "type": "frontend",
      "label": "React + Mock",
      "sublabel": "可运行产品契约"
    },
    {
      "id": "parity",
      "lane": "parity_gate",
      "col": 3,
      "width": 140,
      "type": "security",
      "label": "Prototype Parity",
      "sublabel": "视觉与交互一致?",
      "tag": "GATE"
    },
    {
      "id": "architecture",
      "lane": "contract",
      "col": 3,
      "width": 220,
      "type": "backend",
      "label": "Architecture → SDD / Spec",
      "sublabel": "Draft → Grill → Final → 验收条件"
    },
    {
      "id": "architecture_refine",
      "lane": "architecture_feedback",
      "col": 3,
      "width": 180,
      "type": "external",
      "label": "补充架构约束",
      "sublabel": "部署、安全、可靠性"
    },
    {
      "id": "build_review",
      "lane": "delivery",
      "col": 4,
      "width": 190,
      "type": "backend",
      "label": "Tickets → TDD → Review",
      "sublabel": "实现与 Standards + Spec"
    },
    {
      "id": "feedback",
      "lane": "late_feedback",
      "col": 4,
      "width": 190,
      "type": "external",
      "label": "Diagnose → Fix Ticket",
      "sublabel": "分类问题、补证据、重新实现"
    },
    {
      "id": "ops_readiness",
      "lane": "late_gates",
      "col": 5,
      "width": 150,
      "type": "security",
      "label": "Ops Readiness",
      "sublabel": "运行风险可接受?",
      "tag": "HUMAN GATE"
    },
    {
      "id": "e2e",
      "lane": "delivery",
      "col": 5,
      "width": 200,
      "type": "backend",
      "label": "E2E Evidence",
      "sublabel": "Test Plan → Playwright → Report"
    },
    {
      "id": "acceptance",
      "lane": "outcomes",
      "col": 5,
      "width": 200,
      "type": "security",
      "label": "Human Acceptance → Done",
      "sublabel": "解决最初的问题?",
      "tag": "DELIVERED"
    }
  ],
  "edges": [
    { "from": "idea", "to": "prototype", "label": "问题与目标", "role": "main", "variant": "emphasis" },
    { "from": "prototype", "to": "prototype_review", "label": "交互原型", "role": "main" },
    { "from": "prototype_review", "to": "react", "label": "是 / 意图获批", "role": "main", "variant": "emphasis" },
    { "from": "react", "to": "parity", "label": "产品契约", "role": "main" },
    { "from": "parity", "to": "react", "label": "FAIL", "role": "error", "variant": "dashed" },
    { "from": "parity", "to": "architecture", "label": "PASS / 已接受备注", "role": "main", "variant": "emphasis" },
    { "from": "architecture", "to": "architecture_refine", "label": "关键约束未知", "role": "branch", "variant": "dashed" },
    { "from": "architecture_refine", "to": "architecture", "label": "补充约束", "role": "branch", "variant": "dashed" },
    { "from": "architecture", "to": "build_review", "label": "约束已确认 / Spec + Tickets", "role": "main", "variant": "emphasis", "route": "up-channel" },
    { "from": "build_review", "to": "feedback", "label": "Review 阻断", "role": "error", "variant": "dashed" },
    { "from": "feedback", "to": "build_review", "label": "修复并补证据", "role": "branch", "variant": "dashed" },
    { "from": "build_review", "to": "ops_readiness", "label": "Review 通过", "role": "main", "variant": "emphasis" },
    { "from": "ops_readiness", "to": "feedback", "label": "FAIL / 风险未接受", "role": "error", "variant": "dashed" },
    { "from": "ops_readiness", "to": "e2e", "label": "PASS / 风险已接受", "role": "main", "variant": "emphasis" },
    { "from": "e2e", "to": "feedback", "label": "FAIL / SKIPPED", "role": "error", "variant": "dashed" },
    { "from": "e2e", "to": "acceptance", "label": "PASS", "role": "main", "variant": "emphasis" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Prototype First",
      "items": [
        "可以自行制作 HTML Prototype，也可以从 Beautiful Ops Pages 或 Beautiful Ops Platform 开始",
        "真实使用者先确认页面、流程、交互和状态",
        "Prototype Review 未获批时回到原型继续调整"
      ]
    },
    {
      "dot": "violet",
      "title": "UI + Constraints",
      "items": [
        "React + Mock 是可运行的产品契约，不是最终架构",
        "Architecture 经过 Draft、Grill、Final，确认部署、安全与可靠性约束",
        "SDD / Spec 把已确认的约束转成精确行为和验收条件"
      ]
    },
    {
      "dot": "rose",
      "title": "Evidence Closes The Loop",
      "items": [
        "Parity、Code Review、Ops Readiness、E2E 和 Human Acceptance 都可能触发有边界的修复 Ticket",
        "测试报告提供证据，但最终是否解决最初问题由 Human Acceptance 决定",
        "Done 代表可运行、可验证，不代表跳过人工门禁"
      ]
    }
  ]
}
