          "idea",
          "risk_summary",
          "formal_design",
          "prototype",
          "prototype_review",
          "react",
          "parity",
          "architecture",
          "build_review",
          "ops_readiness",
          "e2e",
          "acceptance",
          "architecture_refine",
          "feedback"
        ],
        "note": "主路径向前推进，所有门禁都可以把工作送回需要修正的阶段。"
      },
      {
        "id": "artifact-review",
        "label": "阶段产物复查",
        "focus": ["delivered_artifact", "score_report", "human_next", "stage_gate"],
        "note": "产物满分 10 分，8 分合格。触发关键项封顶时最高 7 分。人决定是否修订、何时复评，另按原阶段条件放行。"
      },
      {
        "id": "prototype-and-parity",
        "label": "原型与产品契约",
        "focus": [
          "idea",
          "risk_summary",
          "formal_design",
          "prototype",
          "prototype_review",
          "react",
          "parity"
        ],
        "note": "S00 明确人、问题和成功标准。人选定原型目标后进入 S01；已有方案也可在记录风险后结束。"
      },
      {
        "id": "architecture-and-spec",
        "label": "架构与规格",
        "focus": [
          "react",
          "parity",
          "architecture",
          "architecture_refine"
        ],
        "note": "UI 暴露能力候选，Grill 确认约束，Spec 固化可测试行为。"
      },
      {
        "id": "build-and-operations",
        "label": "实现、运行与验收",
        "focus": [
          "architecture",
          "build_review",
          "feedback",
          "ops_readiness",
          "e2e",
          "acceptance"
        ],
        "note": "实现经审查和测试后，由业务使用者和风险负责人确认能否接受。"
      }
    ]
  },
