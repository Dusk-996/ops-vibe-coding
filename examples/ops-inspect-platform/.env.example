# 运行环境：development（开发）或 production（生产，缺强密钥/弱密码直接 Fail-Fast 拒启）
APP_ENV=development

# 认证签名与账号密码（生产环境必须替换为 >=12 位强随机值，严禁保留 changeme）
AUTH_SECRET=changeme_dev_auth_secret_please_replace
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_admin_password_2026
VIEWER_USERNAME=duskk
VIEWER_PASSWORD=changeme_viewer_password_2026

# 受控 CORS 白名单（英文逗号分隔，严禁使用 *）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# SQLite 持久化路径与只读 SSH 私钥目录
DB_PATH=/data/ops_inspect.db
SSH_KEYS_DIR=/run/ssh_keys

# 可选：标准 SMTP 邮箱配置（留空 SMTP_HOST 自动进入本地安全模拟收件箱模式）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=changeme_smtp_password
SMTP_FROM=ops-inspect@corp.local
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
