    { "id": "human_next", "lane": "artifact_review", "col": 4, "width": 160, "type": "security", "label": "人决定下一步", "sublabel": "是否修订、何时发起复评" },
    { "id": "stage_gate", "lane": "artifact_review", "col": 5, "width": 156, "type": "external", "label": "按原门禁处理", "sublabel": "放行、结束、退回或待确认" },
    { "id": "idea", "lane": "intent", "col": 0, "width": 198, "type": "external", "label": "S00 澄清问题与原型目标", "sublabel": "用户、痛点、成功标准" },
    { "id": "risk_summary", "lane": "early_gates", "col": 0, "width": 172, "type": "external", "label": "风险清单", "sublabel": "保留待决事项后结束" },
    { "id": "formal_design", "lane": "contract", "col": 0, "width": 172, "type": "external", "label": "正式设计", "sublabel": "设计获批后编写实施计划" },
    { "id": "prototype", "lane": "intent", "col": 1, "width": 198, "type": "frontend", "label": "S01 制作可交互原型", "sublabel": "选用现有页面或制作 HTML" },
    { "id": "prototype_review", "lane": "early_gates", "col": 1, "width": 146, "type": "security", "label": "S02 用户确认", "sublabel": "关键流程与反馈", "tag": "HUMAN GATE" },
    { "id": "react", "lane": "contract", "col": 2, "width": 170, "type": "frontend", "label": "S03 React + Mock", "sublabel": "可运行产品契约" },
    { "id": "parity", "lane": "parity_gate", "col": 3, "width": 150, "type": "security", "label": "S04 一致性审查", "sublabel": "布局与交互", "tag": "GATE" },
    { "id": "architecture", "lane": "contract", "col": 3, "width": 200, "type": "backend", "label": "S05–S08 架构与规格", "sublabel": "草案、追问、定稿、Spec" },
    { "id": "architecture_refine", "lane": "architecture_feedback", "col": 3, "width": 180, "type": "external", "label": "补充架构约束", "sublabel": "部署、安全、可靠性" },
    { "id": "build_review", "lane": "delivery", "col": 4, "width": 192, "type": "backend", "label": "S09–S11 实现与审查", "sublabel": "Ticket、TDD、代码审查" },
    { "id": "feedback", "lane": "late_feedback", "col": 4, "width": 190, "type": "external", "label": "Diagnose → Fix Ticket", "sublabel": "分类问题、补证据、重新实现" },
    { "id": "ops_readiness", "lane": "late_gates", "col": 5, "width": 150, "type": "security", "label": "S12 就绪审查", "sublabel": "运行风险与证据", "tag": "HUMAN GATE" },
    { "id": "e2e", "lane": "delivery", "col": 5, "width": 180, "type": "backend", "label": "S13 端到端验证", "sublabel": "先批计划，再测场景" },
    { "id": "acceptance", "lane": "outcomes", "col": 5, "width": 180, "type": "security", "label": "S14 人工验收", "sublabel": "接受、补充或退回" }
  ],
  "edges": [
