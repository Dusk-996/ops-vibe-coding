    { "from": "ops_readiness", "to": "e2e", "label": "PASS / 风险已接受", "role": "main", "variant": "emphasis" },
    { "from": "e2e", "to": "feedback", "label": "FAIL / SKIPPED", "role": "error", "variant": "dashed" },
    { "from": "e2e", "to": "acceptance", "label": "PASS", "role": "main", "variant": "emphasis" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "阶段产物复查",
      "items": [
        "每个已交付节点使用适用的同版规则。原始分、最终分、关键项封顶原因和逐项证据进入评分报告。",
        "低于 8 分列出缺口及修改建议。由人决定是否修订或发起复评，复评引用前次报告。",
        "评分与阶段放行分别记录。例如 S13 可以如实记录测试失败并获得 10 分，产品仍须修复。"
      ]
    },
    {
      "dot": "cyan",
      "title": "从问题到原型",
      "items": [
        "S00 确认用户和痛点，定义可观察的成功标准，比较方向并收敛到一个场景。",
        "仅评估已有方案可在风险清单处结束。选择正式设计时，设计获批后接实施计划。",
        "人确认原型目标后进入 S01；真实使用者在 S02 体验并决定是否批准。"
      ]
    },
    {
      "dot": "violet",
      "title": "UI + Constraints",
      "items": [
        "React + Mock 是可运行的产品契约，不是最终架构",
        "S05 架构草案 → S06 逐项确认运行约束 → S07 定稿；S08 将约束写入规格。",
        "SDD / Spec 把已确认的约束转成精确行为和验收条件"
      ]
    },
    {
      "dot": "rose",
      "title": "Evidence Closes The Loop",
      "items": [
        "S09 拆任务，S10 通过测试驱动实现，S11 核对规范和需求。审查或端到端验证发现问题时退回修复。",
        "测试报告提供证据，但最终是否解决最初问题由 Human Acceptance 决定",
        "Done 代表可运行、可验证，不代表跳过人工门禁"
      ]
    }
  ]
}
